CREATE database db_testeformula1;
USE db_testeformula1;

CREATE TABLE tb_paises (
codigoPAIS integer not null primary key,
nomePAIS varchar (30) not null
);

CREATE TABLE tb_equipes (
sigla_EQP varchar (3) not null primary key,
nome_EQP varchar (30) not null,
cod_pais integer not null,
foreign key (cod_pais) references tb_paises(codigoPAIS)
);

CREATE TABLE tb_piloto (
nomePIL varchar(50) not null,
numPIL integer not null primary key,
cod_pais integer not null,
sigla_equipe varchar (3)
);

CREATE TABLE tb_corridas (
siglaGP varchar (3) not null primary key,
nomeGP varchar (30) not null,
cod_pais integer not null,
qtd_voltas integer not null,
foreign key (cod_pais) references tb_paises(codigoPAIS)
);

CREATE TABLE tb_participantes (
sigla_GP VARCHAR(10) not null,
num_piloto integer not null,
posicao_largada integer not null,
primary key (sigla_GP, num_piloto),
foreign key (sigla_GP) references tb_corridas(siglaGP),
foreign key (num_piloto) references tb_piloto(numPIL)
);

