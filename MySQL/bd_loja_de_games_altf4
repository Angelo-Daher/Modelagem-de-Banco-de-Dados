    cliente.nome_cliente,
    SUM(venda.valor_total) AS total_gasto
FROM cliente
INNER JOIN venda
ON cliente.cod_cliente = venda.cod_cliente
GROUP BY cliente.cod_cliente, cliente.nome_cliente
HAVING SUM(venda.valor_total) > 500;


DROP TRIGGER IF EXISTS verificar_estoque;
DROP TRIGGER IF EXISTS atualizar_estoque;


-- TRIGGER 1: Verificar se existe estoque suficiente
DELIMITER //

CREATE TRIGGER verificar_estoque
BEFORE INSERT ON item_venda
FOR EACH ROW
BEGIN

    IF NEW.quantidade <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Quantidade invalida!';
    END IF;

    IF NOT EXISTS (
        SELECT 1
        FROM jogo
        WHERE cod_jogo = NEW.cod_jogo
        AND quantidade_estoque >= NEW.quantidade
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Estoque insuficiente!';
    END IF;

END //

DELIMITER ;


-- TRIGGER 2: Atualizar o estoque após uma venda
DELIMITER //

CREATE TRIGGER atualizar_estoque
AFTER INSERT ON item_venda
FOR EACH ROW
BEGIN

    UPDATE jogo
    SET quantidade_estoque = quantidade_estoque - NEW.quantidade
    WHERE cod_jogo = NEW.cod_jogo;

END //

DELIMITER ;


