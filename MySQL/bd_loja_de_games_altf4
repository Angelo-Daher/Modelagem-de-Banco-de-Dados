CREATE DATABASE LojaGames_ALTF4;
USE LojaGames_ALTF4;

-- Tabela de clientes
CREATE TABLE cliente (
    cod_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nome_cliente VARCHAR(100) NOT NULL,
    telefone_cliente VARCHAR(20),
    cpf_cliente VARCHAR(11) UNIQUE
);


-- Tabela de funcionários
CREATE TABLE funcionario (
    cod_funcionario INT AUTO_INCREMENT PRIMARY KEY,
    nome_funcionario VARCHAR(100) NOT NULL,
    data_nascimento DATE,
    telefone_funcionario VARCHAR(20)
);


-- Tabela de plataformas
CREATE TABLE plataforma (
    cod_plataforma INT AUTO_INCREMENT PRIMARY KEY,
    nome_plataforma VARCHAR(50) NOT NULL,
    plataforma_fabricante VARCHAR(50)
);


-- Tabela de categorias
CREATE TABLE categoria (
    cod_categoria INT AUTO_INCREMENT PRIMARY KEY,
    nome_categoria VARCHAR(50) NOT NULL,
    descricao_categoria VARCHAR(150)
);


-- Tabela de jogos
CREATE TABLE jogo (
    cod_jogo INT AUTO_INCREMENT PRIMARY KEY,
    nome_jogo VARCHAR(100) NOT NULL,
    preco_jogo DECIMAL(10,2) NOT NULL,
    ano_lancamento INT,
    quantidade_estoque INT NOT NULL,
    cod_categoria INT NOT NULL,
    cod_plataforma INT NOT NULL,

    FOREIGN KEY (cod_categoria)
        REFERENCES categoria(cod_categoria),

    FOREIGN KEY (cod_plataforma)
        REFERENCES plataforma(cod_plataforma)
);


-- Tabela de vendas
CREATE TABLE venda (
    cod_venda INT AUTO_INCREMENT PRIMARY KEY,
    data_venda DATE NOT NULL,
    valor_total DECIMAL(10,2) NOT NULL,
    cod_cliente INT NOT NULL,
    cod_funcionario INT NOT NULL,

    FOREIGN KEY (cod_cliente)
        REFERENCES cliente(cod_cliente),

    FOREIGN KEY (cod_funcionario)
        REFERENCES funcionario(cod_funcionario)
);


-- Tabela de itens das vendas
CREATE TABLE item_venda (
    cod_item INT AUTO_INCREMENT PRIMARY KEY,
    quantidade INT NOT NULL,
    preco_unitario DECIMAL(10,2) NOT NULL,
    cod_venda INT NOT NULL,
    cod_jogo INT NOT NULL,

    FOREIGN KEY (cod_venda)
        REFERENCES venda(cod_venda),

    FOREIGN KEY (cod_jogo)
        REFERENCES jogo(cod_jogo)
);


-- Tabela de pagamentos
CREATE TABLE pagamento (
    cod_pagamento INT AUTO_INCREMENT PRIMARY KEY,
    valor_pagamento DECIMAL(10,2) NOT NULL,
    data_pagamento DATE,
    forma_pagamento VARCHAR(30),
    status_pagamento VARCHAR(30),
    cod_venda INT NOT NULL,

    FOREIGN KEY (cod_venda)
        REFERENCES venda(cod_venda)
);

